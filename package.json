{
  "name": "chess-and-cards",
  "version": "0.1.0",
  "private": true,
  "description": "可插拔棋牌娱乐大厅平台",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @cc/api-server dev",
    "dev:room": "pnpm --filter @cc/room-server dev",
    "dev:web": "pnpm --filter @cc/lobby-web dev",
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* --filter=./services/* build",
    "typecheck": "tsc -b --pretty",
    "e2e": "tsx scripts/e2e-smoke.ts",
    "deploy:panel": "node tools/deploy-panel.mjs",
    "clean": "pnpm -r exec rimraf dist node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.6",
    "rimraf": "^6.0.1",
    "ssh2": "^1.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
