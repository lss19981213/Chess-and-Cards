# 复制为 .env 后修改，切勿提交真实密钥
PORT=8080
HOST=127.0.0.1
ROOM_PORT=9000

# 两个服务必须使用相同密钥
JWT_SECRET=please-change-this-secret
INTERNAL_KEY=please-change-this-internal-key
TOKEN_TTL=7200

# 大厅 API 访问游戏服
ROOM_SERVER_URL=http://127.0.0.1:9000
# 游戏服回调大厅（结算上报）
API_BASE_URL=http://127.0.0.1:8080

# 留空则使用内存仓储（重启丢数据），生产必须配置
DATABASE_URL=postgres://cc:CHANGE_ME@127.0.0.1:5432/chess_cards

INITIAL_COINS=1000
CORS_ORIGIN=*
DISCONNECT_GRACE_MS=60000

# 可选：把 /lobby/ 片段注入到已有站点的配置文件路径
# 留空则跳过自动注入，需手动在目标 server 块内 include /etc/nginx/snippets/lobby.conf
NGINX_TARGET_CONF=

# ---- 机器人陪玩（纯本地分级博弈算法） ----
BOT_ENABLED=true
# 机器人「思考」基准停留时间（毫秒）
BOT_THINK_MS=700
