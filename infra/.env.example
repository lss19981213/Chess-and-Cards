# 复制为 .env 后修改，切勿提交真实密钥
PORT=8080
HOST=127.0.0.1
ROOM_PORT=9000
# 游戏服监听地址：默认只监听本机，由 nginx 反代；不要直接暴露 9000
ROOM_HOST=127.0.0.1
# 大厅 API 信任的反代地址（决定 req.ip 取值），默认本机 nginx
TRUST_PROXY=127.0.0.1
# 允许建立 WebSocket 的 Origin，逗号分隔；留空表示只允许同源
WS_ALLOWED_ORIGINS=
# 结算 outbox 目录（落盘后重投，防止丢结算）
SETTLEMENT_OUTBOX_DIR=/opt/chess-and-cards/services/room-server/.outbox

# 生产环境必须设置 NODE_ENV=production，否则密钥校验会放行开发兜底值
NODE_ENV=production

# 以下三项必须替换为 32 位以上随机字符串，两个服务共用同一组值。
# 生成方式：openssl rand -hex 32
# 生产环境仍使用示例值或长度不足时，服务会直接拒绝启动。
JWT_SECRET=please-change-this-secret
INTERNAL_KEY=please-change-this-internal-key
# 运营后台（GM 工具）口令
ADMIN_TOKEN=please-change-this-admin-token
TOKEN_TTL=7200

# 大厅 API 访问游戏服
ROOM_SERVER_URL=http://127.0.0.1:9000
# 游戏服回调大厅（结算上报）
API_BASE_URL=http://127.0.0.1:8080

# 留空则使用内存仓储（重启丢数据），生产必须配置
DATABASE_URL=postgres://cc:CHANGE_ME@127.0.0.1:5432/chess_cards

INITIAL_COINS=1000
# 生产环境请填具体来源，例如 https://example.com
CORS_ORIGIN=*
DISCONNECT_GRACE_MS=60000

# 可选：把 /lobby/ 片段注入到已有站点的配置文件路径
# 留空则跳过自动注入，需手动在目标 server 块内 include /etc/nginx/snippets/lobby.conf
NGINX_TARGET_CONF=

# ---- 机器人陪玩（纯本地分级博弈算法） ----
BOT_ENABLED=true
# 机器人「思考」基准停留时间（毫秒）
BOT_THINK_MS=700
