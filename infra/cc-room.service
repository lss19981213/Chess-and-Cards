[Unit]
Description=Chess & Cards Game Room Server
After=network.target cc-api.service
Wants=cc-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/chess-and-cards/services/room-server
EnvironmentFile=/opt/chess-and-cards/.env
ExecStart=/bin/bash -lc 'exec pnpm exec tsx src/index.ts'
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=1G

[Install]
WantedBy=multi-user.target
